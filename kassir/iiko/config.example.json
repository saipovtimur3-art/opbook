        "dessert": {"type": "pct",   "plan": 20, "icon": "🍟", "label": "закуска/десерт", "groups": ["Закуски", "Десерты"]},
        "combo":   {"type": "pct",   "plan": 12, "icon": "🍔", "label": "комбо", "dish_contains": ["комбо"]},
        "size":    {"type": "pct",   "plan": 40, "icon": "⬆️", "label": "апсайз", "dish_contains": [" L", "большой", "большая"]},
